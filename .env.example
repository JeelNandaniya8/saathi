# Required
DATABASE_URL=
FLASK_SECRET_KEY=
GEMINI_API_KEY=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Production configuration
APP_BASE_URL=https://example.com
COOKIE_SECURE=true
FLASK_DEBUG=false

# Required only for opted-in reminder email delivery
CRON_SECRET=

# Reserved for a future web-push implementation; currently unused
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional verified Google sign-in
GOOGLE_CLIENT_ID=
# Model choices must be available to your Gemini project
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.6-flash
# Billing stays disabled until separately configured and verified
SAATHI_BILLING_MODE=disabled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MERCHANT_VERIFIED=false
